  "reconciliation_contract": {
    "discovery_fanout_before_world_inventory_close": true,
    "exact_source_status_required": [
      "QUERIED",
      "PASS",
      "NO_COVERAGE",
      "BLOCKED",
      "UNAVAILABLE",
      "RATE_LIMITED",
      "AUTH_FAILED"
    ],
    "source_counts_are_never_summed_without_deduplication": true,
    "entity_identity_reconciliation_required": true,
    "provider_aliases_must_be_persisted": true,
    "timestamp_and_timezone_provenance_required": true,
    "every_model_feature_requires_pit_provenance": true,
    "browser_sources_may_expand_discovery_but_not_bypass_model_gates": true,
    "source_native_counters_preferred_over_partial_loaded_link_counts": true,
    "partial_page_or_lazy_load_counts_must_be_labeled_lower_bound": true,
    "world_total_requires_cross_source_reconciliation": true,
    "every_reported_source_total_requires_physical_evidence_path": true
  }
}
