{
  "schema": "MATRIX_MULTI_SOURCE_REGISTRY_V1",
  "version": "1.1.0",
  "effective_date": "2026-10-04",
  "timezone": "America/Bogota",
  "permanent_rule": true,
  "sports_scope": [
    "tennis",
    "football"
  ],
  "global_policy": {
    "all_managed_sources_must_be_considered": true,
    "all_accessible_sources_should_be_queried_for_discovery_and_crosscheck": true,
    "source_failure_or_unavailability_must_be_persisted": true,
    "silent_source_omission_forbidden": true,
    "silent_overwrite_forbidden": true,
    "no_single_source_can_declare_world_complete": true,
    "source_specific_counts_must_remain_source_specific_until_reconciliation": true,
    "canonical_identity_before_cross_provider_merge": true,
    "physical_dedupe_before_counter_increment": true,
    "discrepancies_must_be_persisted_and_adjudicated": true,
    "pit_cutoff_required_for_model_features": true,
    "missing_not_zero": true,
    "silent_imputation_forbidden": true,
    "odds_to_p_matrix_forbidden": true,
    "model_feed_requires_explicit_governed_authorization": true,
    "real_money": "BLOCKED",
    "automatic_wagering": false,
    "native_source_counting_method_must_be_verified_before_reporting_total": true,
    "loaded_links_or_partial_dom_counts_cannot_be_reported_as_source_total": true,
    "paid_api_coverage_must_not_be_assumed_complete": true,
    "public_browser_source_coverage_must_not_be_assumed_complete": true,
    "source_total_claim_requires_method_and_scope_provenance": true,
    "material_count_discrepancy_requires_recount_before_user_report": true
  },
