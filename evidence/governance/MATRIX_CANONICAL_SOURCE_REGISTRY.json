{
  "schema": "MATRIX_CANONICAL_SOURCE_REGISTRY_V1",
  "precedence": [
    "LATEST_PHYSICAL_EVIDENCE",
    "HANDOFF",
    "MEMORY"
  ],
  "response_contract": {
    "current_status_requires_physical_evidence": true,
    "stale_source_must_not_be_reported_as_current": true,
    "missing_evidence_result": "NO_CERTIFICADO",
    "conflicting_sources_result": "FAIL_CLOSED",
    "inference_must_be_labeled": true,
    "current_metric_must_include_source_timestamp": true
  },
  "sources": {
    "football_4000": {
      "canonical_path": "evidence/api_football/governance/MATRIX_FOOTBALL_4000_CANONICAL_TRACKER_LAST.json",
      "timestamp_field": "generated_at_utc",
      "max_age_minutes": 30,
      "required_schema": "MATRIX_FOOTBALL_4000_CANONICAL_TRACKER_V1",
      "metric_path": "global.valid_final_settlement_count",
      "forbidden_current_counter_paths": [
        "v2_lane_counters.1x2.cohort_settlement_count",
        "v2_lane_counters.over_2_5.cohort_settlement_count",
        "v2_lane_counters.under_2_5.cohort_settlement_count"
      ],
      "reconciliation": "global.valid_final_settlement_count + global.pending_count + global.blocked_count == global.frozen_event_count"
    },
    "tennis_three_blocks": {
      "canonical_path": "evidence/tennis/MATRIX_TENNIS_THREE_BLOCK_STAGNATION_AUDIT_LAST.json",
      "timestamp_field": "generated_at_utc",
      "max_age_minutes": 30,
      "required_schema": "MATRIX_TENNIS_THREE_BLOCK_STAGNATION_AUDIT_V1",
      "metric_paths": [
        "blocks.hard.current_counter",
        "blocks.clay.current_counter",
        "blocks.live.current_counter"
      ]
    },
    "live_tennis_cumulative": {
      "canonical_path": "evidence/live_tennis_lab/MATRIX_LIVE_TENNIS_CUMULATIVE_GATE_V1.json",
      "timestamp_field": "generated_at_utc",
      "max_age_minutes": 30,
      "required_schema": "MATRIX_LIVE_TENNIS_CUMULATIVE_GATE_V1",
      "metric_path": "lanes.itf|women|hard.settled_quality_valid_unique_match_count"
    },
    "telegram_daily_bankroll": {
      "canonical_path": "evidence/notifications/telegram/MATRIX_TELEGRAM_DAILY_BANKROLL_CANONICAL_LAST.json",
      "timestamp_field": "generated_at_utc",
      "max_age_minutes": 30,
      "required_schema": "MATRIX_TELEGRAM_DAILY_BANKROLL_CANONICAL_V1",
      "metric_paths": [
        "summary.current_bankroll_cop",
        "summary.total_profit_cop",
        "summary.total_effective_settled"
      ]
    }
  }
}
